PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tilak_industries
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Number of proxies in front of the app (0 = none). Use 2 on Render behind a Vercel rewrite.
TRUST_PROXY=0
