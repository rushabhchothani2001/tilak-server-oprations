PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tilak_industries
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy such as nginx.
TRUST_PROXY=false
